"""Plot iot-sim sensor datasets and optional anomaly-detect results from RustFS.

The plotting functions deliberately keep every input row.  They pass NumPy
arrays directly to Matplotlib's line renderer instead of creating one artist
per point (as ``scatter`` would), which keeps large Parquet datasets practical.
"""

import argparse
import os
from pathlib import Path

import matplotlib.pyplot as plt
import matplotlib.ticker as mticker
import numpy as np
import pandas as pd
import s3fs

S3_ENDPOINT_URL = os.getenv("S3_ENDPOINT_URL", "http://192.168.1.50:9000")
S3_BUCKET_NAME = os.getenv("S3_BUCKET_NAME", "iotsim")
S3_ACCESS_KEY = os.getenv("S3_ACCESS_KEY", "access")
S3_SECRET_KEY = os.getenv("S3_SECRET_KEY", "secret")
S3_PROCESSED_KEY = "processed/water_hammer-2026-08-26T00:00:00Z.parquet"
S3_RESULTS_KEY = "results/"
HAS_RESULTS = False
ANOMALY_THRESHOLD = 3.5
PLOT_COLORS = [
    "tab:blue", "tab:orange", "tab:green", "tab:red", "tab:purple",
    "tab:brown", "tab:pink", "tab:gray", "tab:olive", "tab:cyan",
]


def rustfs() -> s3fs.S3FileSystem:
    """Create a path-style RustFS client using iot-sim/anomaly-detect defaults."""
    return s3fs.S3FileSystem(
        key=S3_ACCESS_KEY,
        secret=S3_SECRET_KEY,
        client_kwargs={"endpoint_url": S3_ENDPOINT_URL},
    )


def read_parquet(filesystem: s3fs.S3FileSystem, key: str) -> pd.DataFrame:
    with filesystem.open(f"{S3_BUCKET_NAME}/{key}", "rb") as source:
        return pd.read_parquet(source, engine="pyarrow")


def anomaly_mask(frame: pd.DataFrame) -> pd.Series:
    """Return explicit anomaly flags when available."""
    for column in ("anomaly_flag", "is_anomalous"):
        if column in frame:
            return frame[column].fillna(False).astype(bool)
    return pd.Series(False, index=frame.index)


def _result_anomaly_mask(frame: pd.DataFrame) -> np.ndarray:
    """Use source flags when present, otherwise use the score threshold."""
    for column in ("anomaly_flag", "is_anomalous"):
        if column in frame:
            return frame[column].fillna(False).astype(bool).to_numpy()
    return (frame["anomaly_score"].to_numpy() > ANOMALY_THRESHOLD)


def _nanosecond_x_values(
    frame: pd.DataFrame, origin: pd.Timestamp
) -> np.ndarray:
    """Return exact int64 nanosecond offsets for Matplotlib's x coordinates.

    Plotting absolute nanoseconds as float32 loses precision.  Offsetting the
    int64 values by one common origin keeps the original row order and all
    nanosecond differences representable before Matplotlib transforms them.
    """
    timestamps = pd.to_datetime(frame["timestamp"])
    if timestamps.dt.tz is not None:
        timestamps = timestamps.dt.tz_convert("UTC").dt.tz_localize(None)
    return (timestamps.astype("int64") - origin.value).to_numpy(dtype=np.int64)


class _NanosecondDateFormatter(mticker.Formatter):
    """Format relative nanosecond coordinates as ordinary UTC dates."""

    def __init__(self, origin: pd.Timestamp) -> None:
        self.origin = origin

    def __call__(self, value: float, position: int | None = None) -> str:
        timestamp = self.origin + pd.to_timedelta(int(round(value)), unit="ns")
        return timestamp.strftime("%Y-%m-%d\n%H:%M:%S")


def plot_metrics_and_anomalies(
    dfs: pd.DataFrame,
    dfr: pd.DataFrame | None = None,
    output_path: str | os.PathLike[str] | None = None,
    show: bool = False,
) -> Path | None:
    """Render all rows and optionally save a standalone high-fidelity PNG.

    ``show`` is opt-in so calling this from a batch job never starts a GUI.
    """
    if dfs.empty or "timestamp" not in dfs:
        raise ValueError("sensor data must contain at least one timestamp row")

    dfs = dfs.sort_values(by="timestamp", kind="stable").reset_index(drop=True)
    if dfr is not None:
        if dfr.empty or "timestamp" not in dfr or "anomaly_score" not in dfr:
            raise ValueError("result data must contain timestamp and anomaly_score")
        dfr = dfr.sort_values(by="timestamp", kind="stable").reset_index(drop=True)

    timestamp_frames = [dfs] + ([dfr] if dfr is not None else [])
    normalized_timestamps = [pd.to_datetime(frame["timestamp"]) for frame in timestamp_frames]
    normalized_timestamps = [
        values.dt.tz_convert("UTC").dt.tz_localize(None)
        if values.dt.tz is not None else values
        for values in normalized_timestamps
    ]
    origin = min(values.min() for values in normalized_timestamps)
    fig, (ax1, ax2) = plt.subplots(nrows=2, ncols=1, figsize=(14, 9), sharex=True)

    sensor_x = _nanosecond_x_values(dfs, origin)

    # ----------------------------------------------------
    # Top Plot (ax1): Physical Sensor Metrics
    # ----------------------------------------------------
    plotted_sensor = 0
    for index, column in enumerate(dfs.columns):
        if column == "timestamp" or not pd.api.types.is_numeric_dtype(dfs[column]):
            continue
        color = PLOT_COLORS[index % len(PLOT_COLORS)]
        # One Line2D artist handles the complete series efficiently in C.
        ax1.plot(sensor_x, dfs[column].to_numpy(), color=color, linewidth=0.5,
                 alpha=0.85, label=column)
        plotted_sensor += 1

    if not plotted_sensor:
        raise ValueError("sensor data must contain at least one numeric metric column")

    # Dynamically set title with the threshold value embedded
    ax1.set_title("IoT Sensor Metrics", fontsize=14)
    ax1.set_ylabel("Sensor Values")
    ax1.grid(True, linestyle=":", alpha=0.5)
    ax1.legend(loc="upper right")

    # ----------------------------------------------------
    # Bottom Plot (ax2): Model Anomaly Scores
    # ----------------------------------------------------
    if dfr is None:
        ax2.remove()
    else:
        result_x = _nanosecond_x_values(dfr, origin)
        ax2.plot(
            result_x,
            dfr["anomaly_score"].to_numpy(),
            label="Anomaly Score",
            color="tab:purple",
            linewidth=0.5,
            alpha=0.8,
        )

        # Mark only flagged rows with a single line artist, not one scatter
        # geometry object per point.
        anomaly_mask_values = _result_anomaly_mask(dfr)
        ax2.plot(
            result_x[anomaly_mask_values],
            dfr.loc[anomaly_mask_values, "anomaly_score"].to_numpy(),
            "ro",
            markersize=2,
            alpha=0.9,
            label="Anomaly Detected",
        )

        ax2.axhline(y=ANOMALY_THRESHOLD, color="tab:red", linestyle=":",
                    linewidth=1.5, label=f"Threshold ({ANOMALY_THRESHOLD})")
        ax2.set_ylabel("Anomaly Score")
        ax2.set_xlabel("Time")
        ax2.grid(True, linestyle=":", alpha=0.5)
        ax2.legend(loc="upper right")

    ax2.xaxis.set_major_locator(mticker.MaxNLocator(8))
    ax2.xaxis.set_major_formatter(_NanosecondDateFormatter(origin))
    plt.tight_layout()

    saved_path: Path | None = None
    if output_path is not None:
        saved_path = Path(output_path)
        saved_path.parent.mkdir(parents=True, exist_ok=True)
        fig.savefig(saved_path, dpi=200, bbox_inches="tight")
        print(f"High-fidelity raw graph saved to {saved_path}")
    if show:
        plt.show()
    plt.close(fig)
    return saved_path


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--output", type=Path, default=Path("high_fidelity_anomaly_report.png"),
        help="save a standalone PNG (default: high_fidelity_anomaly_report.png)",
    )
    parser.add_argument("--show", action="store_true", help="also open the interactive window")
    args = parser.parse_args()

    filesystem = rustfs()
    df = read_parquet(filesystem, S3_PROCESSED_KEY)
    print(df.describe())
    print(df.dtypes)
    if df.empty:
        raise ValueError("no sensor rows remain after timestamp/metric filtering")

    dfr: pd.DataFrame | None = None
    if HAS_RESULTS:
        dfr = read_parquet(filesystem, S3_RESULTS_KEY)

    plot_metrics_and_anomalies(df, dfr, output_path=args.output, show=args.show)


if __name__ == "__main__":
    main()
